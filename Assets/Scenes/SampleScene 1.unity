    name=\"position\" />\r\n    <command_interface name=\"velocity\" />\r\n    <command_interface
    name=\"effort\" />\r\n    <state_interface name=\"position\">\r\n      <!-- initial
    position for the FakeSystem and simulation -->\r\n      <param name=\"initial_value\">0.0</param>\r\n   
    </state_interface>\r\n    <state_interface name=\"velocity\" />\r\n    <state_interface
    name=\"effort\" />\r\n  </joint>\r\n  <sensor name=\"tcp_fts_sensor\">\r\n   
    <state_interface name=\"force.x\" />\r\n    <state_interface name=\"force.y\"
    />\r\n    <state_interface name=\"force.z\" />\r\n    <state_interface name=\"torque.x\"
    />\r\n    <state_interface name=\"torque.y\" />\r\n    <state_interface name=\"torque.z\"
    />\r\n  </sensor>\r\n  <sensor name=\"tcp_pose\">\r\n    <state_interface name=\"position.x\"
    />\r\n    <state_interface name=\"position.y\" />\r\n    <state_interface name=\"position.z\"
    />\r\n    <state_interface name=\"orientation.x\" />\r\n    <state_interface
    name=\"orientation.y\" />\r\n    <state_interface name=\"orientation.z\" />\r\n   
    <state_interface name=\"orientation.w\" />\r\n  </sensor>\r\n  <!-- NOTE The
    following are joints used only for testing with fake hardware and will change
    in the future -->\r\n  <gpio name=\"speed_scaling\">\r\n    <state_interface
    name=\"speed_scaling_factor\" />\r\n    <param name=\"initial_speed_scaling_factor\">1</param>\r\n   
    <command_interface name=\"target_speed_fraction_cmd\" />\r\n    <command_interface
    name=\"target_speed_fraction_async_success\" />\r\n  </gpio>\r\n  <gpio name=\"gpio\">\r\n   
    <command_interface name=\"standard_digital_output_cmd_0\" />\r\n    <command_interface
    name=\"standard_digital_output_cmd_1\" />\r\n    <command_interface name=\"standard_digital_output_cmd_2\"
    />\r\n    <command_interface name=\"standard_digital_output_cmd_3\" />\r\n   
    <command_interface name=\"standard_digital_output_cmd_4\" />\r\n    <command_interface
