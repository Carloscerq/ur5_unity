--- !u!114 &685071090
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 685071088}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<ros2_control name=\"RobotiqGripperHardwareInterface\" type=\"system\">\r\n 
    <!-- Plugins -->\r\n  <hardware>\r\n    <plugin>mock_components/GenericSystem</plugin>\r\n   
    <param name=\"fake_sensor_commands\">False</param>\r\n    <param name=\"state_following_offset\">0.0</param>\r\n 
    </hardware>\r\n  <!-- Joint interfaces -->\r\n  <!-- With Ignition or Hardware,
    they handle mimic joints, so we only need this command interface activated -->\r\n 
    <joint name=\"robotiq_85_left_knuckle_joint\">\r\n    <command_interface name=\"position\"
    />\r\n    <state_interface name=\"position\">\r\n      <param name=\"initial_value\">0.7929</param>\r\n   
    </state_interface>\r\n    <state_interface name=\"velocity\" />\r\n  </joint>\r\n 
    <joint name=\"robotiq_85_right_knuckle_joint\">\r\n    <param name=\"mimic\">robotiq_85_left_knuckle_joint</param>\r\n   
    <param name=\"multiplier\">-1</param>\r\n    <command_interface name=\"position\"
    />\r\n    <state_interface name=\"position\" />\r\n    <state_interface name=\"velocity\"
    />\r\n  </joint>\r\n  <joint name=\"robotiq_85_left_inner_knuckle_joint\">\r\n   
    <param name=\"mimic\">robotiq_85_left_knuckle_joint</param>\r\n    <param name=\"multiplier\">1</param>\r\n   
    <command_interface name=\"position\" />\r\n    <state_interface name=\"position\"
    />\r\n    <state_interface name=\"velocity\" />\r\n  </joint>\r\n  <joint name=\"robotiq_85_right_inner_knuckle_joint\">\r\n   
    <param name=\"mimic\">robotiq_85_left_knuckle_joint</param>\r\n    <param name=\"multiplier\">-1</param>\r\n   
    <command_interface name=\"position\" />\r\n    <state_interface name=\"position\"
    />\r\n    <state_interface name=\"velocity\" />\r\n  </joint>\r\n  <joint name=\"robotiq_85_left_finger_tip_joint\">\r\n   
    <param name=\"mimic\">robotiq_85_left_knuckle_joint</param>\r\n    <param name=\"multiplier\">-1</param>\r\n   
    <command_interface name=\"position\" />\r\n    <state_interface name=\"position\"
    />\r\n    <state_interface name=\"velocity\" />\r\n  </joint>\r\n  <joint name=\"robotiq_85_right_finger_tip_joint\">\r\n   
    <param name=\"mimic\">robotiq_85_left_knuckle_joint</param>\r\n    <param name=\"multiplier\">1</param>\r\n   
    <command_interface name=\"position\" />\r\n    <state_interface name=\"position\"
    />\r\n    <state_interface name=\"velocity\" />\r\n  </joint>\r\n  <gpio name=\"reactivate_gripper\">\r\n   
    <command_interface name=\"reactivate_gripper_cmd\" />\r\n    <command_interface
    name=\"reactivate_gripper_response\" />\r\n  </gpio>\r\n</ros2_control>"
--- !u!114 &685071091
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 685071088}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<ros2_control name=\"ur5e\" type=\"system\">\r\n  <hardware>\r\n   
    <plugin>ur_robot_driver/URPositionHardwareInterface</plugin>\r\n    <param name=\"robot_ip\">0.0.0.0</param>\r\n   
    <param name=\"script_filename\">to_be_filled_by_ur_robot_driver</param>\r\n   
    <param name=\"output_recipe_filename\">to_be_filled_by_ur_robot_driver</param>\r\n   
    <param name=\"input_recipe_filename\">to_be_filled_by_ur_robot_driver</param>\r\n   
    <param name=\"headless_mode\">False</param>\r\n    <param name=\"reverse_port\">50001</param>\r\n   
    <param name=\"script_sender_port\">50002</param>\r\n    <param name=\"reverse_ip\">0.0.0.0</param>\r\n   
    <param name=\"script_command_port\">50004</param>\r\n    <param name=\"trajectory_port\">50003</param>\r\n   
    <param name=\"tf_prefix\"></param>\r\n    <param name=\"non_blocking_read\">True</param>\r\n   
    <param name=\"servoj_gain\">2000</param>\r\n    <param name=\"servoj_lookahead_time\">0.03</param>\r\n   
    <param name=\"use_tool_communication\">False</param>\r\n    <param name=\"kinematics/hash\">calib_12788084448423163542</param>\r\n   
    <param name=\"tool_voltage\">0</param>\r\n    <param name=\"tool_parity\">0</param>\r\n   
    <param name=\"tool_baud_rate\">115200</param>\r\n    <param name=\"tool_stop_bits\">1</param>\r\n   
    <param name=\"tool_rx_idle_chars\">1.5</param>\r\n    <param name=\"tool_tx_idle_chars\">3.5</param>\r\n   
    <param name=\"tool_device_name\">/tmp/ttyUR</param>\r\n    <param name=\"tool_tcp_port\">54321</param>\r\n   
    <param name=\"keep_alive_count\">2</param>\r\n  </hardware>\r\n  <joint name=\"shoulder_pan_joint\">\r\n   
    <command_interface name=\"position\" />\r\n    <command_interface name=\"velocity\"
    />\r\n    <command_interface name=\"effort\" />\r\n    <state_interface name=\"position\">\r\n     
    <!-- initial position for the FakeSystem and simulation -->\r\n      <param name=\"initial_value\">0.0</param>\r\n   
    </state_interface>\r\n    <state_interface name=\"velocity\" />\r\n    <state_interface
    name=\"effort\" />\r\n  </joint>\r\n  <joint name=\"shoulder_lift_joint\">\r\n   
    <command_interface name=\"position\" />\r\n    <command_interface name=\"velocity\"
    />\r\n    <command_interface name=\"effort\" />\r\n    <state_interface name=\"position\">\r\n     
    <!-- initial position for the FakeSystem and simulation -->\r\n      <param name=\"initial_value\">-1.57</param>\r\n   
    </state_interface>\r\n    <state_interface name=\"velocity\" />\r\n    <state_interface
    name=\"effort\" />\r\n  </joint>\r\n  <joint name=\"elbow_joint\">\r\n    <command_interface
    name=\"position\" />\r\n    <command_interface name=\"velocity\" />\r\n    <command_interface
    name=\"effort\" />\r\n    <state_interface name=\"position\">\r\n      <!-- initial
    position for the FakeSystem and simulation -->\r\n      <param name=\"initial_value\">0.0</param>\r\n   
    </state_interface>\r\n    <state_interface name=\"velocity\" />\r\n    <state_interface
    name=\"effort\" />\r\n  </joint>\r\n  <joint name=\"wrist_1_joint\">\r\n    <command_interface
    name=\"position\" />\r\n    <command_interface name=\"velocity\" />\r\n    <command_interface
