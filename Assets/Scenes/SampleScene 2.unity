--- !u!114 &102328818
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 102328816}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<ros2_control name=\"RobotiqGripperHardwareInterface\" type=\"system\">\n 
    <!-- Plugins -->\n  <hardware>\n    <!-- Set use_dummy to true to connect to
    a dummy driver for testing purposes. -->\n    <param name=\"use_dummy\">false</param>\n   
    <plugin>mock_components/GenericSystem</plugin>\n    <param name=\"mock_sensor_commands\">False</param>\n   
    <param name=\"state_following_offset\">0.0</param>\n  </hardware>\n  <!-- Joint
    interfaces -->\n  <!-- With Ignition or Hardware, they handle mimic joints, so
    we only need this command interface activated -->\n  <joint name=\"robotiq_85_left_knuckle_joint\">\n   
    <command_interface name=\"position\" />\n    <state_interface name=\"position\">\n     
    <param name=\"initial_value\">0.7929</param>\n    </state_interface>\n    <state_interface
    name=\"velocity\" />\n  </joint>\n  <joint name=\"robotiq_85_right_knuckle_joint\">\n   
    <param name=\"mimic\">robotiq_85_left_knuckle_joint</param>\n    <param name=\"multiplier\">-1</param>\n   
    <command_interface name=\"position\" />\n    <state_interface name=\"position\"
    />\n    <state_interface name=\"velocity\" />\n  </joint>\n  <joint name=\"robotiq_85_left_inner_knuckle_joint\">\n   
    <param name=\"mimic\">robotiq_85_left_knuckle_joint</param>\n    <param name=\"multiplier\">1</param>\n   
    <command_interface name=\"position\" />\n    <state_interface name=\"position\"
    />\n    <state_interface name=\"velocity\" />\n  </joint>\n  <joint name=\"robotiq_85_right_inner_knuckle_joint\">\n   
    <param name=\"mimic\">robotiq_85_left_knuckle_joint</param>\n    <param name=\"multiplier\">-1</param>\n   
    <command_interface name=\"position\" />\n    <state_interface name=\"position\"
    />\n    <state_interface name=\"velocity\" />\n  </joint>\n  <joint name=\"robotiq_85_left_finger_tip_joint\">\n   
    <param name=\"mimic\">robotiq_85_left_knuckle_joint</param>\n    <param name=\"multiplier\">-1</param>\n   
    <command_interface name=\"position\" />\n    <state_interface name=\"position\"
    />\n    <state_interface name=\"velocity\" />\n  </joint>\n  <joint name=\"robotiq_85_right_finger_tip_joint\">\n   
    <param name=\"mimic\">robotiq_85_left_knuckle_joint</param>\n    <param name=\"multiplier\">1</param>\n   
    <command_interface name=\"position\" />\n    <state_interface name=\"position\"
    />\n    <state_interface name=\"velocity\" />\n  </joint>\n  <gpio name=\"reactivate_gripper\">\n   
    <command_interface name=\"reactivate_gripper_cmd\" />\n    <command_interface
    name=\"reactivate_gripper_response\" />\n  </gpio>\n</ros2_control>"
--- !u!114 &102328819
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 102328816}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<ros2_control name=\"ur\" type=\"system\">\n  <hardware>\n    <plugin>mock_components/GenericSystem</plugin>\n   
    <param name=\"fake_sensor_commands\">False</param>\n    <param name=\"state_following_offset\">0.0</param>\n   
    <param name=\"calculate_dynamics\">true</param>\n  </hardware>\n  <joint name=\"shoulder_pan_joint\">\n   
    <command_interface name=\"position\" />\n    <command_interface name=\"velocity\"
    />\n    <command_interface name=\"effort\" />\n    <state_interface name=\"position\">\n     
    <!-- initial position for the FakeSystem and simulation -->\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"velocity\" />\n    <state_interface
    name=\"effort\" />\n  </joint>\n  <joint name=\"shoulder_lift_joint\">\n    <command_interface
    name=\"position\" />\n    <command_interface name=\"velocity\" />\n    <command_interface
    name=\"effort\" />\n    <state_interface name=\"position\">\n      <!-- initial
    position for the FakeSystem and simulation -->\n      <param name=\"initial_value\">-1.57</param>\n   
    </state_interface>\n    <state_interface name=\"velocity\" />\n    <state_interface
    name=\"effort\" />\n  </joint>\n  <joint name=\"elbow_joint\">\n    <command_interface
    name=\"position\" />\n    <command_interface name=\"velocity\" />\n    <command_interface
    name=\"effort\" />\n    <state_interface name=\"position\">\n      <!-- initial
    position for the FakeSystem and simulation -->\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"velocity\" />\n    <state_interface
    name=\"effort\" />\n  </joint>\n  <joint name=\"wrist_1_joint\">\n    <command_interface
    name=\"position\" />\n    <command_interface name=\"velocity\" />\n    <command_interface
    name=\"effort\" />\n    <state_interface name=\"position\">\n      <!-- initial
    position for the FakeSystem and simulation -->\n      <param name=\"initial_value\">-1.57</param>\n   
    </state_interface>\n    <state_interface name=\"velocity\" />\n    <state_interface
    name=\"effort\" />\n  </joint>\n  <joint name=\"wrist_2_joint\">\n    <command_interface
    name=\"position\" />\n    <command_interface name=\"velocity\" />\n    <command_interface
    name=\"effort\" />\n    <state_interface name=\"position\">\n      <!-- initial
    position for the FakeSystem and simulation -->\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"velocity\" />\n    <state_interface
    name=\"effort\" />\n  </joint>\n  <joint name=\"wrist_3_joint\">\n    <command_interface
    name=\"position\" />\n    <command_interface name=\"velocity\" />\n    <command_interface
    name=\"effort\" />\n    <state_interface name=\"position\">\n      <!-- initial
    position for the FakeSystem and simulation -->\n      <param name=\"initial_value\">0.0</param>\n   
    </state_interface>\n    <state_interface name=\"velocity\" />\n    <state_interface
    name=\"effort\" />\n  </joint>\n  <sensor name=\"tcp_fts_sensor\">\n    <state_interface
    name=\"force.x\" />\n    <state_interface name=\"force.y\" />\n    <state_interface
    name=\"force.z\" />\n    <state_interface name=\"torque.x\" />\n    <state_interface
    name=\"torque.y\" />\n    <state_interface name=\"torque.z\" />\n  </sensor>\n 
    <sensor name=\"tcp_pose\">\n    <state_interface name=\"position.x\" />\n   
    <state_interface name=\"position.y\" />\n    <state_interface name=\"position.z\"
    />\n    <state_interface name=\"orientation.x\" />\n    <state_interface name=\"orientation.y\"
    />\n    <state_interface name=\"orientation.z\" />\n    <state_interface name=\"orientation.w\"
    />\n  </sensor>\n  <!-- NOTE The following are joints used only for testing with
    fake hardware and will change in the future -->\n  <gpio name=\"speed_scaling\">\n   
    <state_interface name=\"speed_scaling_factor\" />\n    <param name=\"initial_speed_scaling_factor\">1</param>\n   
    <command_interface name=\"target_speed_fraction_cmd\" />\n    <command_interface
    name=\"target_speed_fraction_async_success\" />\n  </gpio>\n  <gpio name=\"gpio\">\n   
    <command_interface name=\"standard_digital_output_cmd_0\" />\n    <command_interface
    name=\"standard_digital_output_cmd_1\" />\n    <command_interface name=\"standard_digital_output_cmd_2\"
    />\n    <command_interface name=\"standard_digital_output_cmd_3\" />\n    <command_interface
    name=\"standard_digital_output_cmd_4\" />\n    <command_interface name=\"standard_digital_output_cmd_5\"
    />\n    <command_interface name=\"standard_digital_output_cmd_6\" />\n    <command_interface
    name=\"standard_digital_output_cmd_7\" />\n    <command_interface name=\"standard_digital_output_cmd_8\"
    />\n    <command_interface name=\"standard_digital_output_cmd_9\" />\n    <command_interface
    name=\"standard_digital_output_cmd_10\" />\n    <command_interface name=\"standard_digital_output_cmd_11\"
    />\n    <command_interface name=\"standard_digital_output_cmd_12\" />\n    <command_interface
    name=\"standard_digital_output_cmd_13\" />\n    <command_interface name=\"standard_digital_output_cmd_14\"
    />\n    <command_interface name=\"standard_digital_output_cmd_15\" />\n    <command_interface
    name=\"standard_digital_output_cmd_16\" />\n    <command_interface name=\"standard_digital_output_cmd_17\"
    />\n    <command_interface name=\"standard_analog_output_cmd_0\" />\n    <command_interface
    name=\"standard_analog_output_cmd_1\" />\n    <command_interface name=\"analog_output_domain_cmd\"
    />\n    <command_interface name=\"tool_voltage_cmd\" />\n    <command_interface
    name=\"io_async_success\" />\n    <state_interface name=\"digital_output_0\"
    />\n    <state_interface name=\"digital_output_1\" />\n    <state_interface name=\"digital_output_2\"
    />\n    <state_interface name=\"digital_output_3\" />\n    <state_interface name=\"digital_output_4\"
    />\n    <state_interface name=\"digital_output_5\" />\n    <state_interface name=\"digital_output_6\"
    />\n    <state_interface name=\"digital_output_7\" />\n    <state_interface name=\"digital_output_8\"
    />\n    <state_interface name=\"digital_output_9\" />\n    <state_interface name=\"digital_output_10\"
    />\n    <state_interface name=\"digital_output_11\" />\n    <state_interface
    name=\"digital_output_12\" />\n    <state_interface name=\"digital_output_13\"
    />\n    <state_interface name=\"digital_output_14\" />\n    <state_interface
    name=\"digital_output_15\" />\n    <state_interface name=\"digital_output_16\"
    />\n    <state_interface name=\"digital_output_17\" />\n    <state_interface
    name=\"digital_input_0\" />\n    <state_interface name=\"digital_input_1\" />\n   
    <state_interface name=\"digital_input_2\" />\n    <state_interface name=\"digital_input_3\"
    />\n    <state_interface name=\"digital_input_4\" />\n    <state_interface name=\"digital_input_5\"
    />\n    <state_interface name=\"digital_input_6\" />\n    <state_interface name=\"digital_input_7\"
    />\n    <state_interface name=\"digital_input_8\" />\n    <state_interface name=\"digital_input_9\"
    />\n    <state_interface name=\"digital_input_10\" />\n    <state_interface name=\"digital_input_11\"
    />\n    <state_interface name=\"digital_input_12\" />\n    <state_interface name=\"digital_input_13\"
    />\n    <state_interface name=\"digital_input_14\" />\n    <state_interface name=\"digital_input_15\"
    />\n    <state_interface name=\"digital_input_16\" />\n    <state_interface name=\"digital_input_17\"
    />\n    <state_interface name=\"standard_analog_output_0\" />\n    <state_interface
    name=\"standard_analog_output_1\" />\n    <state_interface name=\"standard_analog_input_0\"
